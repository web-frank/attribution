{
  "name": "attribution",
  "version": "0.1.0",
  "description": "Eight dependency-free marketing attribution models.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "author": "Daniel Raskopin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-frank/attribution.git"
  },
  "keywords": [
    "marketing",
    "attribution",
    "multi-touch",
    "analytics"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
